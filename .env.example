# ==============================================================================
# Dayflow HRMS - Database Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# WARNING: NEVER commit the actual '.env' file or real credentials to Git.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dayflow
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE

# Database Connection Pool & SSL (Optional)
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_SECONDS=30
