# ==============================================================================
# Dayflow HRMS - Database Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# WARNING: NEVER commit the actual '.env' file or real credentials to Git.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dayflow
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE

# Database Connection Pool & SSL (Optional)
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_SECONDS=30

# ==============================================================================
# Frontend API Server Configuration
# ==============================================================================
# Spring Boot backend runs on port 8080 by default; Node fallback runs on port 5000.
VITE_API_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
